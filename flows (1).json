    {
        "id": "757f9ab366894e26",
        "type": "function",
        "z": "e8048db6c98f6ea6",
        "name": "função de contagem de pessoas",
        "func": "// Pega o contador atual (se não existir, começa em 0)\nlet contador = flow.get(\"contadorPessoas\") || 0;\nlet ocupacao_sala = flow.get(\"ocupacaoSala\") || \"0/100\";\nlet max = flow.get(\"max\");\n\n// Lê a ação recebida\nlet acao = msg.payload.evento;\n\nif (max < contador) {\n    max = contador + 1;\n}\n\n// Atualiza o contador conforme a ação\nif (acao === \"entrada\" && contador < max) {\n    contador++;\n} else if (acao === \"saida\" && contador > 0) {\n    contador--;\n}\n\n// Atualiza a string de ocupação\nocupacao_sala = contador + \"/\" + max;\n\n// Define o texto conforme a ocupação\nlet texto;\nif (contador == max || contador > max - 4) {\n    texto = \"Ocupacao maxima\";\n} else if (contador >= max / 2 && contador < max - 4) {\n    texto = \"Ocupacao media\";\n} else if (contador < max / 2 && contador > 0) {\n    texto = \"Ocupacao ok\";\n}else if (contador == 0) {\n    texto = \"Ocupacao vazia\";\n}\n\n\n\n// Salva o novo valor no fluxo\nflow.set(\"contadorPessoas\", contador);\nflow.set(\"ocupacaoSala\", ocupacao_sala);\n\n// Envia ambos os dados\nmsg.payload = {\n    texto_pessoas_na_sala: texto,\n    ocupacao_sala: ocupacao_sala,\n    contador: contador\n};\n\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 970,
        "y": 240,
        "wires": [
