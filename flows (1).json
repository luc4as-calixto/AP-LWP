    {
        "id": "5ee892e8c7fd3387",
        "type": "function",
        "z": "e8048db6c98f6ea6",
        "name": "function 1",
        "func": "let texto = msg.payload.texto_pessoas_na_sala;\n\nif (texto == \"Ocupacao maxima\") {\n    texto = `<font color=red>${msg.payload.texto_pessoas_na_sala}</font>`;\n} else if (texto == \"Ocupacao media\") {\n    texto = `<font color=yellow>${msg.payload.texto_pessoas_na_sala}</font>`;\n} else if (texto == \"Ocupacao ok\") {\n    texto = `<font color=blue>${msg.payload.texto_pessoas_na_sala}</font>`;\n} else if (texto == \"Ocupacdo vazia\") {\n    texto = `<font color=green>${msg.payload.texto_pessoas_na_sala}</font>`;\n}\n\n// Envia ambos os dados\nmsg.payload.texto_pessoas_na_sala = texto;\n\nreturn msg;",
