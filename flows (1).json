    {
        "id": "b3128a610c07ddb8",
        "type": "function",
        "z": "e8048db6c98f6ea6",
        "name": "função do valor max ",
        "func": "let contador = flow.get(\"contadorPessoas\") || 0;\nlet aviso;\n\nlet max = msg.payload; // valor vindo do slider\nmsg.payload = { max }; // ajusta a estrutura\n\n// Garante que o max nunca seja menor que o contador atual\nif (max < contador) {\n  max = contador + 1;\n  aviso = '<font color=\"red\">Número escolhido para a ocupação<br>está menor que a ocupação atual</font>';\n}\n\n// Armazena o novo limite máximo no fluxo\nflow.set(\"max\", max);\n\n// Retorna o aviso no payload\nmsg.payload.aviso = aviso || \"OK\";\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
