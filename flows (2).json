    {
        "id": "8ebdbc6ecff5aa47",
        "type": "function",
        "z": "df3813a758af17ab",
        "name": "função do valor max ",
        "func": "let max = msg.payload; // valor vindo do slider\n\nmsg.payload = { max }; // ajusta a estrutura\n\n// Atualiza o gauge com limites dinâmicos\nmsg.ui_update = {\n    min: 0,\n    max: max\n};\n\n// Armazena o novo limite máximo no fluxo\nflow.set(\"max\", max);\n\nreturn msg;\n",
